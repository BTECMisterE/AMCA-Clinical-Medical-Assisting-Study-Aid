rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Put the instructor/admin Google email(s) here, lowercase.
    // Must match ADMIN_EMAILS in index.html.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email.lower() in ['kenneth.elyosius@gmail.com'];
    }

    // Questions: any signed-in student may READ; only the admin may WRITE.
    match /questions/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Progress: a student reads/writes only their own document.
    // The admin may READ every student's progress (for the dashboard).
    match /progress/{uid} {
      allow read:  if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
